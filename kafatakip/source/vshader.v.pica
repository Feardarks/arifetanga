; KafaTakip vertex shader: position = mvp * position, color passed through.

; Uniforms
.fvec mvp[4]

; Constants
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  ones myconst.yyyy

; Outputs
.out outpos position
.out outclr color

; Inputs
.alias inpos v0
.alias inclr v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mov outclr.xyz, inclr
	mov outclr.w,   ones

	end
.end
